DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/social_graph
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
REDIS_URL=redis://localhost:6379/0
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
REQUEST_TIMEOUT=30
CRAWLER_MAX_RETRIES=3
CRAWLER_BACKOFF_SECONDS=0.25
CRAWLER_RATE_LIMIT=5.0
CRAWLER_CONCURRENCY=5
# Public Wikipedia and Mastodon work without credentials. A GitHub token raises rate limits.
CRAWLER_USER_AGENT=SocialGraphCrawler/1.0 (local development)
# Local .env: GITHUB_TOKEN=.  Codespaces secret: SOCIAL_GRAPH_GITHUB_TOKEN.
GITHUB_TOKEN=
MASTODON_INSTANCE=mastodon.social
# Optional. Some Mastodon instances require a token for public relationship endpoints.
MASTODON_ACCESS_TOKEN=
